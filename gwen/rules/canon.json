      "platforms": [
        "yt_long",
        "tiktok"
      ],
      "escalation": {
        "duration_scale": "linear:2..9@250"
      },
      "law": 3,
      "role": "presence"
    },
    {
      "id": "presence.recede",
      "tier": 1,
      "meaning": "Moving away, never toward. She is leaving the frame at the moment of loss.",
      "trigger": {
        "type": "on_tag",
        "tag": "LOSS",
        "min_confidence": 0.75,
        "max_per_episode": 1
