      "asset": "glyphs/nidana_{v}.png",
      "variants": 12,
      "placement": {
        "anchor": "tag_mid",
        "offset_frames": 0,
        "duration_frames": 2,
        "region": "full"
      },
      "platform_mode": "carrier_only",
      "escalation": {
        "duration_scale": "linear:2..5@250"
      },
      "role": "glyph",
      "sequence": "message",
      "_pace_note": "Tuning knob for message assembly speed. Verify at episode 50 with gwen_message.py --schedule against the real emitted count in the ledger, and adjust ONCE. After that it is frozen \u2014 changing the pace mid-run changes nothing already shipped, but it does change how long the community waits."
    },
    {
      "id": "audio.interval",
      "tier": 1,
      "meaning": "The sonic signature. Survives only at YouTube-long bitrates, which is why it lives there and nowhere else.",
      "trigger": {
        "type": "on_tag",
        "tag": "THRESHOLD",
        "min_confidence": 0.7,
        "max_per_episode": 2
