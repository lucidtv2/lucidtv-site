{
  "version": 1,
  "salt": "gwen-v1",
  "apogee_interval": 50,
  "max_tier_normal": 2,
  "max_insertions_per_episode": 9,
  "subtlety_clamp_frames": 8,
  "terminal_episode": 250,
  "silent_episodes": [
    250
  ],
  "_silent_note": "Law 10. Episode 250 renders with an empty plan. The layer's loudest act is its absence.",
  "platforms": [
    "yt_long",
    "yt_shorts",
    "tiktok",
    "reels",
    "x",
    "site"
  ],
  "fragment_stride": 5,
  "_stride_note": "Must be coprime with the platform count (6) or the carrier rotation collapses into a weekly pattern and following one account becomes sufficient. 5 is coprime with 6; 3 is NOT \u2014 it would visit only two platforms forever.",
  "movements": [
    {
      "n": 1,
      "name": "Aperture",
      "episodes": [
        1,
        50
      ],
      "grade": "green-cyan",
      "gap": "pixel-cluster"
    },
    {
      "n": 2,
      "name": "Accumulation",
      "episodes": [
        51,
        100
      ],
      "grade": "sodium-amber",
      "gap": "defined-void"
    },
    {
      "n": 3,
      "name": "Turning",
      "episodes": [
        101,
        150
      ],
      "grade": "magenta",
      "gap": "large"
    },
    {
      "n": 4,
      "name": "Implication",
      "episodes": [
        151,
        200
      ],
      "grade": "near-monochrome",
      "gap": "see-through"
    },
    {
      "n": 5,
      "name": "Release",
      "episodes": [
        201,
        250
      ],
      "grade": "natural",
      "gap": "closing"
    }
  ],
  "eggs": [
    {
      "id": "counter.silence",
      "tier": 0,
      "meaning": "The running total of tagged CLINGING spans across every episode to date. The silent confirmation mechanism. It only ever goes up.",
      "trigger": {
        "type": "on_tag",
        "tag": "SILENCE",
        "min_confidence": 1.0,
        "max_per_episode": 1
      },
      "asset": null,
      "placement": {
        "anchor": "tag_start",
        "offset_frames": 4,
        "duration_frames": 24,
        "region": "corner_br"
      },
      "platforms": [
        "reels",
        "yt_long"
      ],
      "law": 6,
      "role": "overlay"
    },
    {
      "id": "grade.movement",
      "tier": 0,
      "meaning": "Per-movement colour grade. Shifts land exactly on the 50-boundaries. Costs nothing; noticed by everyone eventually.",
      "trigger": {
        "type": "always"
      },
      "asset": "luts/movement_{m}.cube",
      "placement": {
        "anchor": "absolute",
        "frame": 0,
        "duration_frames": 0,
        "region": "full"
      },
      "platforms": [
        "yt_long",
        "yt_shorts",
        "tiktok",
        "reels"
      ],
      "role": "grade"
    },
    {
      "id": "caption.payload",
      "tier": 0,
