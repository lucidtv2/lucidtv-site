        "duration_scale": "linear:3..10@250"
      },
      "law": 8,
      "role": "presence"
    },
    {
      "id": "glyph.single",
      "tier": 1,
      "meaning": "One nidana glyph. Carries the message being assembled across 150 episodes. Routed to the harshest transcode because high-contrast silhouettes are the only thing that survives it.",
      "trigger": {
        "type": "on_tag",
        "tag": "NAMING",
        "min_confidence": 0.8,
        "max_per_episode": 1,
        "pace": 0.75
