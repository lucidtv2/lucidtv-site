      "trigger": {
        "type": "always"
      },
      "asset": null,
      "placement": {
        "anchor": "tag_start",
        "offset_frames": 0,
        "duration_frames": 0,
        "region": "caption"
      },
      "platforms": [
        "yt_long",
        "yt_shorts",
        "reels"
      ],
      "role": "caption"
